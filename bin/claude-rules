#!/usr/bin/env bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# claude-rules  —  Claude Code interaction rules CLI
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
set -euo pipefail

VERSION="1.0.0"
CONFIG_FILE=".claude-rules"

# ── Change this to your repo ──
REMOTE_BASE="${CLAUDE_RULES_REMOTE:-https://raw.githubusercontent.com/JiahaoZhu11/claude-rules/main}"

# ─── Colors ──────────────────────────────────────────
RED='\033[0;31m'    GREEN='\033[0;32m'
YELLOW='\033[1;33m' BLUE='\033[0;34m'
CYAN='\033[0;36m'   BOLD='\033[1m'
DIM='\033[2m'       NC='\033[0m'

# ─── Helpers ─────────────────────────────────────────
info()    { printf "${CYAN}i${NC}  %s\n" "$1" >&2; }
success() { printf "${GREEN}✓${NC}  %s\n" "$1" >&2; }
warn()    { printf "${YELLOW}!${NC}  %s\n" "$1" >&2; }
err()     { printf "${RED}✖${NC}  %s\n" "$1" >&2; }

# tty detection — real terminal or fallback to stdin
HAS_TTY=false
if (echo </dev/tty) 2>/dev/null; then HAS_TTY=true; fi

read_input() {
  if $HAS_TTY; then
    read -r "$@" </dev/tty
  else
    read -r "$@"
  fi
}

ask() {
  local prompt="$1" default="$2" result
  printf "${CYAN}?${NC}  ${BOLD}%s${NC} ${DIM}(%s)${NC} " "$prompt" "$default" >&2
  read_input result
  echo "${result:-$default}"
}

ask_yn() {
  local prompt="$1" default="${2:-y}" result
  if [[ "$default" == "y" ]]; then
    printf "${CYAN}?${NC}  ${BOLD}%s${NC} ${DIM}(Y/n)${NC} " "$prompt" >&2
  else
    printf "${CYAN}?${NC}  ${BOLD}%s${NC} ${DIM}(y/N)${NC} " "$prompt" >&2
  fi
  read_input result
  [[ "${result:-$default}" =~ ^[Yy] ]]
}

header() {
  echo "" >&2
  printf "  ${BOLD}${BLUE}claude-rules${NC}  ${DIM}v${VERSION}${NC}\n" >&2
  printf "  ${DIM}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n" >&2
  echo "" >&2
}

# ─── Config ──────────────────────────────────────────

rules_path=""
lessons_path=""
arch_doc=""
claude_md=""

load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then return 1; fi
  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    value="${value#\"}" ; value="${value%\"}"
    case "$key" in
      RULES_PATH)    rules_path="$value" ;;
      LESSONS_PATH)  lessons_path="$value" ;;
      ARCH_DOC)      arch_doc="$value" ;;
      CLAUDE_MD)     claude_md="$value" ;;
    esac
  done < "$CONFIG_FILE"
  return 0
}

save_config() {
  cat > "$CONFIG_FILE" <<EOF
# claude-rules config — auto-generated
# Run 'claude-rules setup' to change.
VERSION="${VERSION}"
RULES_PATH="${rules_path}"
LESSONS_PATH="${lessons_path}"
ARCH_DOC="${arch_doc}"
CLAUDE_MD="${claude_md}"
EOF
  success "Config saved to ${CONFIG_FILE}"
}

# ─── Template ────────────────────────────────────────

generate_rules() {
  cat <<'HEADER'
# Claude Code 交互规则

> 所有 session 共用的协作规则。Claude Code 必须遵守。

HEADER

  if [[ -n "$arch_doc" ]]; then
    echo "> **架构文档**：→ \`${arch_doc}\`"
    echo ""
  fi

  cat <<TABLE
## 规则总览

| # | 规则 | 触发 | 行为 |
|---|------|------|------|
| 1 | 拒绝模糊指令 | 指令有歧义 | 追问确认，不默默猜 |
| 2 | 调试升级 - 加 log | bug 修 1-2 次没好 | 建议加 console.log |
| 3 | 卡住升级 | console.log 没好 或 同方案 3+ 轮 | 停下 → 提替代方案（含跨 agent 选项）→ 用户选了再准备材料 |
| 4 | 修复后反思 | bug 修好后 | 总结"应该怎么问" |
| 5 | 记录经验 | 反思完后 | 写入 \`${lessons_path}\` |
| 6 | 并行探索 | 新功能/新组件起步 | 提方案（含跨 agent 选项）→ 用户选了再准备材料 |
| 7 | 文档先行 | 多文件新功能 | 先写 implementation plan |

TABLE

  cat <<DETAIL
---

## 详细说明

### 1. 拒绝模糊指令

- **触发**：指令存在歧义或关键信息缺失
- **行为**：主动追问确认，不要默默猜测然后做错

### 2. 调试升级 - 加 log

- **触发**：同一个 bug 修了 1-2 次还没解决
- **行为**：建议在关键路径加 console.log 定位问题

### 3. 卡住升级

- **触发**：
  - console.log 加了还是没定位到问题，或
  - 同一个方案迭代 3+ 轮没搞定
- **行为（分两步）**：
  1. **第一步 — 提方案**：停下来，提几个替代方向让用户选择。方案中必须包含一个选项："要不要去其他 session/agent 多方求证？"
  2. **第二步 — 准备材料（仅在用户选了跨 agent 时）**：整理一份 \`.md\` 文件，包含：
     - 问题描述和上下文
     - 已尝试过的方案及结果
     - console.log / 错误信息等关键线索
     - 建议的提问方向
     - 一条可以直接发给其他 agent 的完整消息

### 4. 修复后反思

- **触发**：bug 修好后
- **行为**：直接总结"这个问题当初应该怎么问 / 怎么排查会更快"

### 5. 记录经验

- **触发**：反思完成后
- **行为**：将经验写入 \`${lessons_path}\`，格式：
  \`\`\`
  ## [日期] 简短标题
  - **问题**：遇到了什么
  - **原因**：根因是什么
  - **教训**：下次应该怎么做
  \`\`\`

### 6. 并行探索

- **触发**：新功能或新组件的起步阶段
- **行为（分两步）**：
  1. **第一步 — 提方案**：提几个可能的实现方向让用户选择。方案中必须包含一个选项："要不要去其他 session/agent 多方求证？"
  2. **第二步 — 准备材料（仅在用户选了跨 agent 时）**：整理一份 \`.md\` 文件，包含：
     - 功能需求和背景
     - 当前考虑的几个方案及各自优劣
     - 希望对方帮忙评估的具体问题
     - 一条可以直接发给其他 agent 的完整消息

### 7. 文档先行

- **触发**：涉及多文件改动的新功能
- **行为**：先写 implementation plan（文件列表、改动要点、依赖关系），确认后再动手写代码
DETAIL
}

# ─── File generators ─────────────────────────────────

inject_claude_md() {
  local section
  section=$(cat <<SECTION

## 交互规则

开发过程中的协作规则（追问、调试升级、卡住处理、反思等）：→ \`${rules_path}\`

**必须遵守**，每个 session 生效。
SECTION
)

  if [[ ! -f "$claude_md" ]]; then
    cat > "$claude_md" <<MD
# Project Guide
${section}
MD
    success "Created ${claude_md}"
    return
  fi

  if grep -q "交互规则" "$claude_md" 2>/dev/null; then
    warn "${claude_md} already references interaction rules, skipping"
    return
  fi

  echo "$section" >> "$claude_md"
  success "Injected reference into ${claude_md}"
}

create_lessons_file() {
  if [[ -f "$lessons_path" ]]; then
    info "${lessons_path} already exists, skipping"
    return
  fi
  mkdir -p "$(dirname "$lessons_path")"
  cat > "$lessons_path" <<'LESSONS'
# Learned Lessons

> Auto-maintained by Claude Code. Each entry is added after a post-fix reflection.
LESSONS
  success "Created ${lessons_path}"
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Commands
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── help ────────────────────────────────────────────

cmd_help() {
  header
  printf "  ${BOLD}Usage${NC}:  claude-rules <command>\n" >&2
  echo "" >&2
  printf "  ${BOLD}Commands${NC}\n" >&2
  echo "  ─────────────────────────────" >&2
  printf "  ${GREEN}setup${NC}     Initialize interaction rules in current project\n" >&2
  printf "  ${GREEN}status${NC}    Show current config and file status\n" >&2
  printf "  ${GREEN}update${NC}    Update claude-rules CLI to the latest version\n" >&2
  printf "  ${GREEN}version${NC}   Show version (and check for updates)\n" >&2
  printf "  ${GREEN}help${NC}      Show this help\n" >&2
  echo "" >&2
  printf "  ${BOLD}Install${NC}\n" >&2
  echo "  ─────────────────────────────" >&2
  printf "  ${DIM}/bin/bash -c \"\$(curl -fsSL ${REMOTE_BASE}/install.sh)\"${NC}\n" >&2
  echo "" >&2
  printf "  ${BOLD}Quick start${NC}\n" >&2
  echo "  ─────────────────────────────" >&2
  echo "  cd your-project" >&2
  echo "  claude-rules setup" >&2
  echo "" >&2
}

# ─── setup ───────────────────────────────────────────

cmd_setup() {
  header
  local has_config=false

  # Step 0: check .git
  if [[ ! -d ".git" ]]; then
    warn "Current directory is not a git repository."
    if ! ask_yn "Continue anyway?" "n"; then
      info "Aborted. cd into a git repo and try again."
      return 0
    fi
    echo "" >&2
  fi

  # Load existing config (if any) — values become defaults
  if load_config; then
    has_config=true
    info "Existing configuration detected. Press Enter on each step to keep current value."
    echo "" >&2
  fi

  # Step 1–4: interactive questions
  rules_path=$(ask "Rules file path" "${rules_path:-docs/interaction-rules.md}")
  claude_md=$(ask "CLAUDE.md path" "${claude_md:-CLAUDE.md}")
  lessons_path=$(ask "Learned lessons file path" "${lessons_path:-docs/learned-lessons.md}")

  local arch_default="n"
  if [[ -n "$arch_doc" ]]; then arch_default="y"; fi
  if ask_yn "Reference an architecture doc?" "$arch_default"; then
    arch_doc=$(ask "Architecture doc path" "${arch_doc:-docs/architecture.md}")
  else
    arch_doc=""
  fi

  # Summary
  echo "" >&2
  printf "  ${BOLD}Summary${NC}\n" >&2
  echo "  ─────────────────────────────" >&2
  echo "  Rules file:       ${rules_path}" >&2
  echo "  CLAUDE.md:        ${claude_md}" >&2
  echo "  Lessons file:     ${lessons_path}" >&2
  [[ -n "$arch_doc" ]] && echo "  Architecture doc: ${arch_doc}" >&2
  echo "" >&2

  if ! ask_yn "Proceed?"; then
    warn "Aborted."
    return 1
  fi
  echo "" >&2

  # Generate files
  mkdir -p "$(dirname "$rules_path")"
  generate_rules > "$rules_path"
  success "Created ${rules_path}"

  create_lessons_file
  inject_claude_md
  save_config

  echo "" >&2
  printf "  ${GREEN}${BOLD}Done!${NC} Interaction rules are ready.\n" >&2
  echo "" >&2
  info "Claude Code will pick up the rules automatically via CLAUDE.md."
  info "Run 'claude-rules setup' again anytime to reconfigure."
}

# ─── status ──────────────────────────────────────────

cmd_status() {
  if ! load_config; then
    err "No config found. Run 'claude-rules setup' first."
    return 1
  fi

  header
  printf "  ${BOLD}Config${NC}  ${DIM}(${CONFIG_FILE})${NC}\n" >&2
  echo "  ─────────────────────────────" >&2
  echo "  Rules file:       ${rules_path}" >&2
  echo "  CLAUDE.md:        ${claude_md}" >&2
  echo "  Lessons file:     ${lessons_path}" >&2
  [[ -n "$arch_doc" ]] && echo "  Architecture doc: ${arch_doc}" >&2
  echo "" >&2

  printf "  ${BOLD}Files${NC}\n" >&2
  echo "  ─────────────────────────────" >&2
  [[ -f "$rules_path" ]]   && success "${rules_path}"   || warn "${rules_path} — missing"
  [[ -f "$claude_md" ]]    && success "${claude_md}"    || warn "${claude_md} — missing"
  [[ -f "$lessons_path" ]] && success "${lessons_path}" || warn "${lessons_path} — missing"
  if [[ -n "$arch_doc" ]]; then
    [[ -f "$arch_doc" ]]   && success "${arch_doc}"     || warn "${arch_doc} — missing"
  fi
  echo "" >&2
}

# ─── version ─────────────────────────────────────────

cmd_version() {
  printf "claude-rules ${BOLD}v${VERSION}${NC}\n" >&2

  # Check for updates
  printf "${DIM}Checking for updates...${NC} " >&2
  local remote_version
  if remote_version=$(curl -fsSL "${REMOTE_BASE}/VERSION" 2>/dev/null); then
    remote_version=$(echo "$remote_version" | tr -d '[:space:]')
    if [[ "$remote_version" == "$VERSION" ]]; then
      printf "${GREEN}up to date${NC}\n" >&2
    else
      printf "${YELLOW}v${remote_version} available${NC}\n" >&2
      info "Run 'claude-rules update' to upgrade."
    fi
  else
    printf "${DIM}could not check (network error)${NC}\n" >&2
  fi
}

# ─── update (self-update) ───────────────────────────

cmd_update() {
  header

  # Find where we're installed
  local self_path
  self_path="$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")"

  info "Current: v${VERSION}"
  printf "${DIM}  Checking remote...${NC} " >&2

  local remote_version
  if ! remote_version=$(curl -fsSL "${REMOTE_BASE}/VERSION" 2>/dev/null); then
    printf "${RED}failed${NC}\n" >&2
    err "Could not reach remote. Check your network or CLAUDE_RULES_REMOTE."
    return 1
  fi
  remote_version=$(echo "$remote_version" | tr -d '[:space:]')
  printf "${GREEN}v${remote_version}${NC}\n" >&2

  if [[ "$remote_version" == "$VERSION" ]]; then
    success "Already up to date."
    return 0
  fi

  info "Updating v${VERSION} → v${remote_version}..."

  local tmp_file="${self_path}.tmp.$$"
  if ! curl -fsSL "${REMOTE_BASE}/bin/claude-rules" -o "$tmp_file" 2>/dev/null; then
    err "Download failed."
    rm -f "$tmp_file"
    return 1
  fi

  chmod +x "$tmp_file"
  mv "$tmp_file" "$self_path"

  echo "" >&2
  success "Updated to v${remote_version}"
  info "Run 'claude-rules setup' in your projects to regenerate rules with the latest template."
}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Main
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

main() {
  local cmd="${1:-help}"

  case "$cmd" in
    setup|init)      cmd_setup ;;
    status)          cmd_status ;;
    update)          cmd_update ;;
    version|-v|--version)  cmd_version ;;
    help|-h|--help)  cmd_help ;;
    *)
      cmd_help
      ;;
  esac
}

main "$@"
